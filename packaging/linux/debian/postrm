#!/bin/sh
set -e

if [ "$1" = "remove" ]; then
    if [ -d /run/systemd/system ]; then
        systemctl --system daemon-reload >/dev/null || true
    fi
    if [ -x /usr/bin/deb-systemd-helper ]; then
        deb-systemd-helper mask nestris-terminal-update.path >/dev/null || true
    fi
fi

if [ "$1" = "purge" ]; then
    if [ -x /usr/bin/deb-systemd-helper ]; then
        deb-systemd-helper purge nestris-terminal-update.path >/dev/null || true
        deb-systemd-helper unmask nestris-terminal-update.path >/dev/null || true
    fi
    rm -rf /var/lib/nestris-terminal /var/lib/nestris-terminal-update
    # The group stays: users may still be members. Per-user settings live in
    # ~/.local/share/NestrisTerminal and are not touched.
fi

exit 0
