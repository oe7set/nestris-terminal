#!/bin/sh
set -e

UPD=/var/lib/nestris-terminal/updates

if [ "$1" = "configure" ]; then
    # Members may hand updates to the root helper (the kiosk user).
    if ! getent group nestris-terminal >/dev/null; then
        groupadd --system nestris-terminal
    fi
    install -d -m 0755 /var/lib/nestris-terminal
    # setgid: files the kiosk drops here belong to the group, so the helper
    # can answer with a result the kiosk may read and delete.
    install -d -m 2770 -o root -g nestris-terminal "$UPD"
    chown root:nestris-terminal "$UPD"
    chmod 2770 "$UPD"

    deb-systemd-helper unmask nestris-terminal-update.path >/dev/null || true
    deb-systemd-helper enable nestris-terminal-update.path >/dev/null || true
    if [ -d /run/systemd/system ]; then
        systemctl --system daemon-reload >/dev/null || true
        # Never "restart": during an update this runs inside the helper's own run.
        deb-systemd-invoke start nestris-terminal-update.path >/dev/null || true
    fi
fi

if [ "$1" = "configure" ] && [ -z "${2:-}" ]; then
    echo "nestris-terminal installed. Next steps (docs/DEBIAN.md):"
    echo "  sudo usermod -aG dialout,nestris-terminal <kiosk user>   (then sign in again)"
    echo "  as the kiosk user: nestris-terminal configure --host http://<nestris-ltm>:7990 --token <token>"
    echo "                     nestris-terminal autostart on"
fi

exit 0
